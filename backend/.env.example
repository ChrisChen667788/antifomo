# Demo default (zero dependency):
DATABASE_URL=sqlite:///./anti_fomo_demo.db

# If you want PostgreSQL, use for example:
# DATABASE_URL=postgresql+pg8000://postgres:postgres@localhost:5432/anti_fomo_demo

SINGLE_USER_ID=00000000-0000-0000-0000-000000000001
LLM_PROVIDER=mock
LLM_FALLBACK_TO_MOCK=true
RESEARCH_LLM_FALLBACK_TO_MOCK=false
LLM_MAX_RETRIES=1
LANGCHAIN_STRUCTURED_OUTPUT_METHOD=json_schema
LANGCHAIN_STRUCTURED_OUTPUT_FALLBACK_METHOD=json_mode
OCR_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
OPENAI_VISION_MODEL=
OPENAI_TEMPERATURE=0.2
OPENAI_TIMEOUT_SECONDS=120
RESEARCH_LLM_TIMEOUT_SECONDS=300
RESEARCH_LLM_MAX_OUTPUT_TOKENS=7000
RESEARCH_SNAPSHOT_RECOVERY_ENABLED=true
RESEARCH_SNAPSHOT_RECOVERY_MAX_AGE_HOURS=48
# Optional USD prices per 1M tokens. Leave blank instead of guessing vendor prices.
OPENAI_INPUT_COST_PER_MILLION=
OPENAI_CACHED_INPUT_COST_PER_MILLION=
OPENAI_OUTPUT_COST_PER_MILLION=
OPENAI_ORGANIZATION=
OPENAI_PROJECT=
OPENAI_VERIFY_SSL=true
OPENAI_CA_BUNDLE=
STRATEGY_LLM_PROVIDER=openai
STRATEGY_OPENAI_API_KEY=
STRATEGY_OPENAI_BASE_URL=https://api.openai.com/v1
STRATEGY_OPENAI_MODEL=
STRATEGY_OPENAI_TEMPERATURE=0.1
STRATEGY_OPENAI_TIMEOUT_SECONDS=90
STRATEGY_LLM_MAX_RETRIES=1
STRATEGY_MODEL_QUALIFICATION_REQUIRED=true
STRATEGY_MODEL_QUALIFICATION_MAX_AGE_DAYS=30
STRATEGY_OPENAI_INPUT_COST_PER_MILLION=
STRATEGY_OPENAI_CACHED_INPUT_COST_PER_MILLION=
STRATEGY_OPENAI_OUTPUT_COST_PER_MILLION=
WECHAT_FAVORITES_LLM_ROLE=strategy
WECHAT_FAVORITES_LLM_TIMEOUT_SECONDS=45
URL_FETCH_TIMEOUT_SECONDS=12
RESEARCH_SEARCH_TIMEOUT_SECONDS=10
RESEARCH_MAX_SEARCH_RESULTS=4
RESEARCH_MAX_SOURCES=4
RESEARCH_SOURCE_EXCERPT_CHARS=900
# Optional reranker. Keep disabled unless the SentenceTransformers model is installed/cached.
RESEARCH_CROSS_ENCODER_RERANK_ENABLED=false
RESEARCH_CROSS_ENCODER_BACKEND=auto
RESEARCH_CROSS_ENCODER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RESEARCH_CROSS_ENCODER_TOP_K=20
RESEARCH_CROSS_ENCODER_CACHE_DIR=
RESEARCH_CROSS_ENCODER_DEVICE=auto
# Decision Studio semantic index. BGE-M3 is loaded lazily; set enabled=false until
# the model is cached when running in an offline environment.
DECISION_EMBEDDING_ENABLED=true
DECISION_EMBEDDING_PROVIDER=sentence_transformers
DECISION_EMBEDDING_MODEL=BAAI/bge-m3
DECISION_EMBEDDING_BATCH_SIZE=16
DECISION_EMBEDDING_CACHE_DIR=
DECISION_EMBEDDING_XET_CACHE_DIR=
DECISION_EMBEDDING_DISABLE_SYMLINKS=false
DECISION_EMBEDDING_DEVICE=auto
# Optional Docling parser adapter; native OOXML/text parsing remains available.
DECISION_DOCLING_ENABLED=false
# Required before a governed Skill can be signed or approved.
DECISION_SKILL_SIGNING_KEY=
# Comma-separated host allowlist for HTTP/MCP connector dry-run approval.
DECISION_CONNECTOR_ALLOWED_DOMAINS=
# Auto-expand public evidence when report/material self-evaluation stays at watch/fail.
RESEARCH_QUALITY_EXPANSION_ENABLED=true
RESEARCH_QUALITY_EXPANSION_MIN_SCORE=82
RESEARCH_QUALITY_EXPANSION_MAX_ROUNDS=2
RESEARCH_QUALITY_EXPANSION_QUERY_LIMIT=8
# Production graph orchestration. Use deterministic for rollback; langgraph_shadow remains a legacy alias.
RESEARCH_WORKFLOW_ENGINE=langgraph
RESEARCH_JOB_WORKER_ENABLED=true
RESEARCH_JOB_WORKER_POLL_SECONDS=1
RESEARCH_JOB_LEASE_SECONDS=1800
RESEARCH_JOB_RECOVER_RUNNING_ON_STARTUP=true
RESEARCH_JOB_RECOVERY_MAX_AGE_HOURS=24
# Optional provider-side quota meter. Prefer this when an OpenAI-compatible gateway
# does not publish per-model token prices; the report records a before/after CNY estimate.
GATEWAY_USAGE_METER_ENABLED=false
GATEWAY_USAGE_URL=
GATEWAY_QUOTA_UNITS_PER_CNY=500000
GATEWAY_USAGE_TIMEOUT_SECONDS=6
WECHAT_AGENT_AUTO_START=false
PENDING_ITEM_RECOVERY_ENABLED=true
PENDING_ITEM_RECOVERY_INTERVAL_SECONDS=8
PENDING_ITEM_GRACE_SECONDS=10
PROCESSING_STALE_SECONDS=90
PENDING_ITEM_RECOVERY_BATCH_SIZE=12
PENDING_ITEM_MAX_ATTEMPTS=4
WORKBUDDY_WEBHOOK_SECRET=
WORKBUDDY_MODE=auto
WORKBUDDY_SIGNATURE_HEADER=x-workbuddy-signature
WORKBUDDY_TIMESTAMP_HEADER=x-workbuddy-timestamp
WORKBUDDY_SIGNATURE_TTL_SECONDS=300
WORKBUDDY_DEFAULT_CALLBACK_URL=
WORKBUDDY_CALLBACK_BEARER_TOKEN=
WORKBUDDY_CALLBACK_TIMEOUT_SECONDS=12
WORKBUDDY_OFFICIAL_CLI_COMMAND=codebuddy
WORKBUDDY_OFFICIAL_MODEL=glm-5.2
WORKBUDDY_OFFICIAL_GATEWAY_URL=
WORKBUDDY_OFFICIAL_GATEWAY_HEALTH_URL=
WORKBUDDY_OFFICIAL_GATEWAY_WEBHOOK_URL=
WORKBUDDY_OFFICIAL_GATEWAY_BEARER_TOKEN=
WORKBUDDY_OFFICIAL_PROBE_TIMEOUT_SECONDS=6
WORKBUDDY_OFFICIAL_CLI_TIMEOUT_SECONDS=90

# AIPRO OpenAI-compatible gateway example:
# LLM_PROVIDER=langchain_openai
# OPENAI_API_KEY=<YOUR_OPENAI_API_KEY>
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=<YOUR_MODEL_NAME>
#
# Optional strategy/audit model for research pipeline:
# STRATEGY_OPENAI_API_KEY=<YOUR_STRATEGY_MODEL_API_KEY>
# STRATEGY_OPENAI_BASE_URL=https://api.openai.com/v1
# STRATEGY_OPENAI_MODEL=<YOUR_STRATEGY_MODEL_NAME>
