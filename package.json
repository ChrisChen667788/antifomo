    "competitive:monitor:test": "node --test scripts/competitive_monitor.test.mjs",
    "miniapp:data-source-state:test": "node --test scripts/miniapp_data_source_state.test.mjs",
    "office:roundtrip": "backend/.venv311/bin/python scripts/validate_office_roundtrip.py",
    "office:visual-baseline": "backend/.venv311/bin/python scripts/generate_formal_artifact_visual_baseline.py",
