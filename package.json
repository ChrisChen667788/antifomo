{
  "name": "anti-fomo-demo",
  "version": "2.9.5",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3010",
    "build": "next build",
    "start": "next start --port 3010",
    "lint": "eslint",
    "test:frontend": "vitest run",
    "test:frontend:watch": "vitest",
    "test:backend": "cd backend && .venv311/bin/pytest -q",
    "check": "npm run lint && npm run test:frontend && npm run competitive:monitor:test && npm run miniapp:data-source-state:test && npm run build && npm run test:backend",
    "security:scan": "python3 scripts/secret_scan.py",
    "security:scan:history": "python3 scripts/secret_scan.py --history",
    "security:scan:local": "python3 scripts/secret_scan.py --include-ignored-local --report-only",
    "demo:setup": "bash scripts/setup_demo.sh",
    "demo:backend": "bash scripts/run_backend.sh",
    "demo:frontend": "bash scripts/run_frontend.sh",
    "demo:start": "bash scripts/start_demo.sh",
    "demo:stop": "bash scripts/stop_demo.sh",
    "workbuddy:doctor": "bash scripts/workbuddy_official_doctor.sh",
    "demo:smoke": "bash scripts/smoke_test.sh",
    "stability:smoke": "python3 scripts/stability_smoke.py",
