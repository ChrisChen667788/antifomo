    "research:watchlists:automation:uninstall": "backend/.venv311/bin/python scripts/manage_watchlist_launch_agent.py uninstall",
    "research:watchlists:automation:status": "backend/.venv311/bin/python scripts/manage_watchlist_launch_agent.py status",
    "research:evaluate": "backend/.venv311/bin/python scripts/run_research_evaluation.py",
    "research:evaluate:parity": "backend/.venv311/bin/python scripts/run_research_workflow_parity.py",
    "research:evaluate:review:export": "backend/.venv311/bin/python scripts/export_research_evaluation_review.py",
    "research:evaluate:review:finalize": "backend/.venv311/bin/python scripts/finalize_research_evaluation_review.py",
    "research:evaluate:review:validate": "backend/.venv311/bin/python scripts/validate_research_evaluation_review.py",
    "research:evaluate:calibration:export": "backend/.venv311/bin/python scripts/export_research_expert_calibration.py",
    "research:evaluate:calibration:finalize": "backend/.venv311/bin/python scripts/finalize_research_expert_calibration.py",
    "research:evaluate:calibration:validate": "backend/.venv311/bin/python scripts/validate_research_expert_calibration.py",
    "research:architecture:validate": "backend/.venv311/bin/python scripts/run_solution_proof_of_architecture.py",
    "research:evaluate:plan-live": "backend/.venv311/bin/python scripts/plan_research_live_evaluation.py",
    "studio:validation:specs": "backend/.venv311/bin/python scripts/decision_studio_release_program.py specs",
    "studio:validation:preview": "backend/.venv311/bin/python scripts/decision_studio_release_program.py preview",
    "studio:validation:record": "backend/.venv311/bin/python scripts/decision_studio_release_program.py record",
    "studio:release": "backend/.venv311/bin/python scripts/decision_studio_release_program.py release",
    "studio:audit": "backend/.venv311/bin/python scripts/decision_studio_release_program.py audit",
    "studio:reliability": "backend/.venv311/bin/python scripts/decision_studio_release_program.py probe"
